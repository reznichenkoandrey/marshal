{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "noEmitOnError": true,
    "types": ["node", "chrome"]
  },
  "include": [
    "main.ts",
    "operator-main.ts",
    "agent/**/*.ts",
    "operator/**/*.ts",
    "desktop/**/*.ts",
    "desktop/**/*.cts",
    "chrome-extension/src/**/*.ts"
  ]
}
