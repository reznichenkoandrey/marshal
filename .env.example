# Reasoning bridge selection.
# Supported modes:
#   claude-cli  — local `claude` CLI (Claude Pro/Max subscription)      [DEFAULT]
#   codex-cli   — local `codex`  CLI (ChatGPT Plus/Pro subscription)
#   claude      — Anthropic Messages API (requires ANTHROPIC_API_KEY)
#   api         — OpenAI-compatible API (Groq/OpenRouter/OpenAI)
#   claude-web  — claude.ai web UI via Playwright
#   playwright  — chatgpt.com web UI via Playwright
#   extension   — ChatGPT via Chrome extension bridge
MARSHAL_BRIDGE_MODE=claude-cli

# claude-cli: path + model override (defaults: `claude` on PATH, model `sonnet`)
# Run `claude auth` once to authenticate with your Pro/Max subscription.
MARSHAL_CLAUDE_BIN=claude
MARSHAL_CLAUDE_MODEL=sonnet

# codex-cli: path + model override (defaults: `codex` on PATH, CLI default model)
# Run `codex login` once and choose "Sign in with ChatGPT".
MARSHAL_CODEX_BIN=codex
MARSHAL_CODEX_MODEL=

# Anthropic API (only for MARSHAL_BRIDGE_MODE=claude)
ANTHROPIC_API_KEY=
MARSHAL_MODEL=claude-sonnet-4-20250514

# OpenAI-compatible provider (only for MARSHAL_BRIDGE_MODE=api and Groq translator backend)
MARSHAL_API_KEY=
MARSHAL_API_BASE=https://api.groq.com/openai/v1

# ── Translator backend selection ─────────────────────────────────────
# Which engine the floating translator (Cmd+Cmd+C and screenshot OCR) calls.
# Supported backends:
#   claude-cli — local `claude` CLI, billed to Claude Pro/Max         [DEFAULT]
#   codex-cli  — local `codex`  CLI, billed to ChatGPT Plus/Pro
#   groq       — Groq OpenAI-compatible API (needs MARSHAL_API_KEY)
# Changing this does NOT affect the agent reasoning bridge — that stays on
# MARSHAL_BRIDGE_MODE.
MARSHAL_TRANSLATOR_BACKEND=claude-cli

# Vision model for image translation (Translator feature, groq backend only)
# Groq: llama-3.2-11b-vision-preview | OpenRouter: meta-llama/llama-3.2-11b-vision-instruct
MARSHAL_VISION_MODEL=llama-3.2-11b-vision-preview

# Translator tuning (all optional, groq backend only)
# Temperature (0.0-2.0, default 0.1 for terminology-stable output)
MARSHAL_TRANSLATOR_TEMPERATURE=0.1
# Max tokens per response (default 4096)
MARSHAL_TRANSLATOR_MAX_TOKENS=4096
# Retry count on 429/5xx responses (default 3, set 0 to disable)
MARSHAL_TRANSLATOR_MAX_RETRIES=3

# ── Voice dictation (push-to-talk) ───────────────────────────────────
# Enable/disable (default 1). When disabled the hotkey is not registered.
MARSHAL_DICTATION_ENABLED=1
# Push-to-talk hotkey. Hold to record, release to transcribe.
# Examples: `RightCmd` (hold right Command alone), `Cmd+Shift+D`, `F19`.
MARSHAL_DICTATION_HOTKEY=RightCmd
# Transcription backend:
#   (unset)     — auto-pick: hybrid if MARSHAL_API_KEY is set, else whisper-cpp
#   hybrid      — Groq whisper-large-v3 with local whisper.cpp fallback (recommended)
#   groq        — Groq whisper-large-v3 only, fails loudly if offline (needs MARSHAL_API_KEY)
#   whisper-cpp — local-only, offline, free. Requires ./scripts/install-whisper-cpp.sh
# Free tier covers 4 hrs/day on Groq for whisper-large-v3 (28800 sec/day @ turbo).
# MARSHAL_DICTATION_BACKEND=hybrid
# Spoken language: `auto` (default, whisper detects per clip), `uk`, `en`.
# Pin a language if auto-detect misfires on short utterances.
MARSHAL_DICTATION_LANGUAGE=auto
# Auto-paste transcript after dictation (not yet implemented; placeholder)
MARSHAL_DICTATION_AUTOPASTE=0
# Initial prompt (glossary + style hint) seeded into whisper each transcription.
# Huge accuracy win on mixed-language speech and rare technical terms.
# Whisper caps this at ~1000 chars. Leave unset to use the bundled dev-glossary;
# explicit empty string disables prompting entirely.
# MARSHAL_DICTATION_PROMPT="Я розробник, React, Magento, PR, deploy..."
# Set to 1 to log each hotkey event, recorder state, and WAV size to stdout.
# Handy for debugging the push-to-talk flow (see #49).
MARSHAL_DICTATION_DEBUG=0

# whisper.cpp binary + model (override only if you relocated them).
# Default model installed by setup:dictation is ggml-large-v3-turbo (~800 MB,
# 8× more params than the old ggml-small, free, offline). For maximum local
# quality install ggml-large-v3 (~1.5 GB) via `WHISPER_MODEL=ggml-large-v3 npm run setup:dictation`.
# MARSHAL_WHISPER_BIN=.whisper/bin/whisper-cli
# MARSHAL_WHISPER_MODEL=.whisper/models/ggml-large-v3-turbo.bin
# MARSHAL_WHISPER_THREADS=4
# Groq whisper model id (override only)
# MARSHAL_WHISPER_MODEL_REMOTE=whisper-large-v3

CHATGPT_URL=https://chatgpt.com
CHATGPT_HEADLESS=false
CHATGPT_STORAGE_STATE_PATH=./agent/.auth/chatgpt-storage.json
CHATGPT_USER_DATA_DIR=./agent/.chrome-profile
CHATGPT_BROWSER_EXECUTABLE_PATH="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
CHATGPT_CDP_URL=http://127.0.0.1:9222
CHATGPT_REMOTE_DEBUGGING_PORT=9222
CHATGPT_EXTENSION_BRIDGE_PORT=3210
AGENT_WORKSPACE_ROOT=./agent/workspace
