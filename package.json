{
  "name": "local-chatgpt-agent",
  "version": "0.1.8",
  "private": true,
  "type": "module",
  "description": "Local autonomous agent that uses the ChatGPT web UI via Playwright as its reasoning engine.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node index.ts",
    "operator": "npm run build && node dist/operator-main.js",
    "desktop": "npm run build && electron dist/desktop/main.js",
    "desktop:dev": "npm run build && ELECTRON_ENABLE_LOGGING=1 electron dist/desktop/main.js",
    "smoke:phase4": "npm run build && node dist/agent/smoke/phase4.js",
    "acceptance:phase6": "npm run build && node dist/agent/acceptance/phase6.js",
    "acceptance:phase7": "bash agent/acceptance/phase7-launcher.sh",
    "acceptance:phase8": "npm run build && node dist/agent/acceptance/phase8-operator.js",
    "acceptance": "npm run acceptance:phase6 && npm run acceptance:phase7 && npm run acceptance:phase8",
    "desktop:pack": "npm run build && electron-builder --dir -c.mac.identity=null",
    "desktop:dist": "npm run build && electron-builder --mac",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json && node scripts/postbuild.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && node tests/e2e/smoke.mjs",
    "check": "npm run typecheck && npm run test",
    "setup:dictation": "bash scripts/install-whisper-cpp.sh",
    "setup:codesign-cert": "bash scripts/setup-codesign-cert.sh"
  },
  "build": {
    "appId": "com.marshal.desktop",
    "productName": "Marshal",
    "afterSign": "scripts/notarize.cjs",
    "files": [
      "dist/**/*",
      "assets/**/*",
      "operator/static/**/*",
      "open-chatgpt-browser-default-profile.sh",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**/*",
      "dist/desktop/dictation/audio-recorder",
      "dist/desktop/dictation/focus-probe",
      "dist/desktop/dictation/insert-text",
      "dist/desktop/dictation/mic-list",
      "dist/desktop/dictation/ptt-monitor",
      "dist/desktop/dictation/whisper-cli",
      "dist/desktop/dictation/ggml-small.bin",
      "dist/desktop/capture/screen-recorder",
      "dist/desktop/capture/system-audio-recorder",
      "dist/desktop/capture/scroll-capture",
      "dist/desktop/capture/scroll-stitch",
      "dist/desktop/translator/apple-vision-ocr",
      "dist/desktop/translator/send-keystroke"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "assets/icon.icns",
      "identity": "099164E16AE88B2052B842BE1036FB10411B7239",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "artifactName": "Marshal-${version}-${arch}.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "extendInfo": {
        "LSUIElement": true,
        "NSMicrophoneUsageDescription": "Marshal needs microphone access to transcribe your voice dictation.",
        "NSAppleEventsUsageDescription": "Marshal uses Apple Events to auto-paste dictated text.",
        "NSScreenCaptureUsageDescription": "Marshal captures a selected screen region for OCR translation."
      }
    },
    "dmg": {
      "title": "Marshal ${version}",
      "icon": "assets/icon.icns",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "directories": {
      "output": "release"
    }
  },
  "main": "dist/desktop/main.js",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "dotenv": "^17.4.2",
    "ffmpeg-static": "^5.3.0",
    "playwright": "^1.54.2",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@types/chrome": "^0.1.24",
    "@types/node": "^24.3.0",
    "@vitest/coverage-v8": "^4.1.6",
    "electron": "^41.7.2",
    "electron-builder": "^26.15.2",
    "electron-playwright-helpers": "^2.1.0",
    "typescript": "^5.9.2",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "@electron/asar": "4.2.0",
    "global-agent": "4.1.3"
  }
}
