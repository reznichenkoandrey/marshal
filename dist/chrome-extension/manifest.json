{
  "manifest_version": 3,
  "name": "Marshal ChatGPT Bridge",
  "version": "0.1.0",
  "description": "Local bridge between Marshal agent and a real ChatGPT tab in Chrome.",
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Marshal ChatGPT Bridge"
  }
}
