{
  "manifest_version": 3,
  "name": "Marshal AI Bridge",
  "version": "0.3.0",
  "description": "Side panel chat with Claude via your desktop Marshal app — pick any element on the page and ask.",
  "permissions": [
    "storage",
    "tabs",
    "sidePanel",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "side_panel": {
    "default_path": "src/sidepanel/sidepanel.html"
  },
  "action": {
    "default_title": "Marshal AI"
  }
}
